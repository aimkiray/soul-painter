generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/chat-sync.db"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sessions  Session[]
}

model Session {
  id          String    @id // Client-generated session ID
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  titleSource String    @default("auto")
  createdAt   DateTime
  // updatedAt is the server-side commit stamp (echo cursor); clientStamp is the
  // client's own entity stamp used for last-write-wins — never mix the two
  // clock domains.
  updatedAt   DateTime
  clientStamp BigInt    @default(0)
  deletedAt   DateTime?
  
  messages    Message[]

  @@index([userId, updatedAt(sort: Desc)])
}

model Message {
  id        String    @id // Client-generated message ID
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String    // "user" or "bot"
  createdAt DateTime
  // Server commit stamp for the echo cursor; clientStamp is the client's
  // entity stamp for last-write-wins comparisons.
  updatedAt DateTime
  clientStamp BigInt  @default(0)
  deletedAt DateTime?
  
  text      String
  prompt    String
  images    String    // JSON stringified ImageHit[]
  code      String    @default("")
  extra     String    @default("") // Versioned sync metadata envelope; legacy rows remain plain text
  
  @@index([sessionId, createdAt(sort: Asc)])
}
