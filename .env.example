# Server-default credentials — used when the browser provides no key.
# Leave unset to require users to enter keys in Settings or via URL params.
DEFAULT_API_KEY=
DEFAULT_BASE_URL=https://api.openai.com/v1

# Optional chat-specific credentials (fall back to the pair above)
# DEFAULT_CHAT_API_KEY=
# DEFAULT_CHAT_BASE_URL=

# Claude-compatible chat credentials (fall back to chat defaults)
# DEFAULT_CLAUDE_API_KEY=
# DEFAULT_CLAUDE_BASE_URL=https://api.anthropic.com/v1

# Chat model lists (comma-separated; models are also discovered from /models)
# OPENAI_CHAT_MODELS=gpt-4o,gpt-4o-mini
# CLAUDE_CHAT_MODELS=claude-sonnet-4-5
# DEFAULT_OPENAI_CHAT_MODEL=
# DEFAULT_CLAUDE_CHAT_MODEL=
# DEFAULT_OPENAI_TITLE_MODEL=
# DEFAULT_CLAUDE_TITLE_MODEL=

# Required in production when browsers use the server-default keys above;
# enter the same value in Connection Settings.
# SERVER_ACCESS_TOKEN=

# Model gate — locks the model selector until the footer version stamp is
# triple-tapped. Secret signs the unlock cookie.
# MODEL_GATE_ENABLED=
# MODEL_GATE_SECRET=

# Chat asset storage limits (server-side image mirroring)
# CHAT_ASSET_SESSION_SECRET=
# CHAT_ASSET_MAX_IMAGE_BYTES=8388608
# CHAT_ASSET_SESSION_MAX_BYTES=268435456
# CHAT_ASSETS_MAX_TOTAL_BYTES=1073741824

# Set to 1 ONLY when a reverse proxy (nginx etc.) overwrites/appends
# X-Forwarded-For — rate limiting keys on the real client IP then.
# Without it, forwarded headers are ignored (all clients share one bucket).
# TRUST_PROXY=1

# Server-side run concurrency and SSE event-stream caps
# MAX_CONCURRENT_RUNS=4
# RUN_SSE_MAX=50
