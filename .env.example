# 后端默认 API Key（前端留空时使用此 Key）
DEFAULT_API_KEY=sk-your-key-here

# 默认 OpenAI-compatible / 图像 API Base URL
DEFAULT_BASE_URL=https://api.openai.com/v1

# 聊天专用的默认 API Key 和 Base URL
# 留空时回落到上面的 DEFAULT_API_KEY / DEFAULT_BASE_URL
DEFAULT_CHAT_API_KEY=
DEFAULT_CHAT_BASE_URL=

# OpenAI Compatible 聊天模型，多个值以逗号分隔
# 仅配置列表时，第一项作为默认聊天模型，最后一项作为标题模型
OPENAI_CHAT_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
DEFAULT_OPENAI_CHAT_MODEL=gpt-5.6-sol
DEFAULT_OPENAI_TITLE_MODEL=gpt-5.6-terra

# Claude Compatible 专用的默认 API Key 和 Base URL
# 留空时回落到 DEFAULT_CHAT_API_KEY / DEFAULT_CHAT_BASE_URL
DEFAULT_CLAUDE_API_KEY=
DEFAULT_CLAUDE_BASE_URL=https://api.anthropic.com/v1

# Claude Compatible 聊天模型，多个值以逗号分隔
# 仅配置列表时，第一项作为默认聊天模型，最后一项作为标题模型
CLAUDE_CHAT_MODELS=claude-fable-5,claude-opus-4-8,claude-sonnet-5,claude-haiku-4-5
DEFAULT_CLAUDE_CHAT_MODEL=claude-sonnet-5
DEFAULT_CLAUDE_TITLE_MODEL=claude-haiku-4-5

# 生产环境使用服务端默认 API Key 时必须提供的独立访问令牌
SERVER_ACCESS_TOKEN=replace-with-a-long-random-token

# 仅在明确接受公开消耗服务端默认 API Key 的风险时启用
ALLOW_ANONYMOUS_DEFAULT_API_KEY=false

# 额外允许作为自定义上游的私网主机名，多个值以逗号分隔
UPSTREAM_HOST_ALLOWLIST=

# 允许读取代理响应的跨域 Origin，多个值以逗号分隔；同源请求无需配置
ALLOWED_ORIGINS=

# 启用后，用户必须连点 header 版本号 3 次才可调用模型
MODEL_GATE_ENABLED=false

# 用于签名门禁解锁 Cookie；生产环境建议设置为随机长字符串
MODEL_GATE_SECRET=

# 聊天图片服务端存储限制；前端聊天记录只保存这些图片的 URL
CHAT_ASSET_MAX_IMAGE_BYTES=8388608
CHAT_ASSET_SESSION_MAX_BYTES=268435456
CHAT_ASSET_SESSION_MAX_FILES=200
CHAT_ASSET_SESSION_MAX_AGE_DAYS=30
CHAT_ASSET_MAX_BODY_BYTES=11198464
CHAT_ASSET_CACHE_MAX_AGE_SECONDS=3600
CHAT_ASSET_COOKIE_SECURE=auto
CHAT_ASSET_REMOTE_FETCH_TIMEOUT_MS=15000
CHAT_ASSET_REMOTE_FETCH_MAX_REDIRECTS=3
