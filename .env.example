# 后端默认 API Key（前端留空时使用此 Key）
DEFAULT_API_KEY=sk-your-key-here

# 默认上游 API Base URL
DEFAULT_BASE_URL=https://api.tu-zi.com

# 聊天（OpenAI 兼容）专用的默认 API Key 和 Base URL
# 留空时回落到上面的 DEFAULT_API_KEY / DEFAULT_BASE_URL
DEFAULT_CHAT_API_KEY=
DEFAULT_CHAT_BASE_URL=

# 启用后，用户必须连点 header 版本号 3 次才可调用模型
MODEL_GATE_ENABLED=false

# 用于签名门禁解锁 Cookie；生产环境建议设置为随机长字符串
MODEL_GATE_SECRET=

# 聊天图片服务端存储限制；前端聊天记录只保存这些图片的 URL
CHAT_ASSET_MAX_IMAGE_BYTES=8388608
CHAT_ASSET_SESSION_MAX_BYTES=268435456
CHAT_ASSET_SESSION_MAX_FILES=200
CHAT_ASSET_SESSION_MAX_AGE_DAYS=30
CHAT_ASSET_MAX_BODY_BYTES=11198464
CHAT_ASSET_CACHE_MAX_AGE_SECONDS=3600
CHAT_ASSET_COOKIE_SECURE=auto
CHAT_ASSET_REMOTE_FETCH_TIMEOUT_MS=15000
CHAT_ASSET_REMOTE_FETCH_MAX_REDIRECTS=3
